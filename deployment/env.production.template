# Rename this file to .env after replacing every value marked CHANGE_ME.
CI_ENVIRONMENT = production

# Keep the trailing slash.
app.baseURL = 'https://CHANGE_ME.example/'
app.siteURL = 'https://CHANGE_ME.example/'
app.indexPage = ''
app.checkURL = true

# The database name and username on shared hosting commonly include an account prefix.
database.default.hostname = localhost
database.default.database = CHANGE_ME_database
database.default.username = CHANGE_ME_user
database.default.password = CHANGE_ME_password
database.default.DBDriver = MySQLi
database.default.port = 3306

# This application also declares the "data" connection. Use the same database unless
# your installation deliberately uses a separate one.
database.data.hostname = localhost
database.data.database = CHANGE_ME_database
database.data.username = CHANGE_ME_user
database.data.password = CHANGE_ME_password
database.data.DBDriver = MySQLi
database.data.port = 3306

# Preserve the values from the current production installation when migrating an
# existing site. For a fresh site, generate long random values before going live.
encryption.key = CHANGE_ME_LONG_RANDOM_SECRET
security.TOKEN_SECRET = CHANGE_ME_LONG_RANDOM_SECRET
security.TOKEN_IAT = 10
security.TOKEN_NBF = 60
security.TOKEN_EXP = 3600
security.TOKEN_ALG = HS256

# Optional integrations.
GEMINI_API_KEY =
GEMINI_MODEL = gemini-3-flash-preview
HCAPTCHA_SITE_KEY =
HCAPTCHA_SECRET_KEY =

# Configure SMTP only when outbound email is required.
email.SMTPHost =
email.SMTPUser =
email.SMTPPass =
email.SMTPPort = 587
email.SMTPCrypto = tls
email.fromEmail = noreply@CHANGE_ME.example
email.fromName = INLISLite
